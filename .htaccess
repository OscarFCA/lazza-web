# Lazza Arquitectura — configuración de Apache en HostGator
#
# Este archivo solo actúa en el hosting. GitHub Pages lo ignora.
# Escrito el 10-sep-2026, al mover el sitio de Pages a HostGator.

# ---------------------------------------------------------------------------
# Página de error propia
# ---------------------------------------------------------------------------
ErrorDocument 404 /404.html

# ---------------------------------------------------------------------------
# Canonicalización de dominio
#
# Los canonical de las 34 páginas ya apuntan a https://lazza.com.mx/ sin www,
# así que el servidor manda www → raíz para que no existan dos URLs del mismo
# contenido.
# ---------------------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On

  # REACTIVADAS el 15-sep-2026. Se cumplieron las dos condiciones que las
  # tenían esperando: la raíz ya propagó en todos los resolvers y AutoSSL
  # emitió el certificado el 12-sep (cubre lazza.com.mx y www, vence el
  # 11-dic-2026 y se renueva solo).
  #
  # Hasta hoy el mismo contenido respondía en cuatro URLs —http y https, con y
  # sin www—, que es contenido duplicado de manual. Los canonical ya apuntaban
  # a https://lazza.com.mx/, pero un canonical sugiere y un 301 resuelve. Con
  # el sitio recién abierto a indexación, conviene que el primer rastreo
  # encuentre una sola dirección.

  # Una sola regla para los dos casos, y a propósito: encadenarlas hacía que
  # http://www diera dos saltos (a https://www y de ahí a la raíz). Un 301 en
  # cadena diluye y se rastrea peor; así cualquiera de las tres formas malas
  # llega en un solo salto a la buena.
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} ^www\.lazza\.com\.mx$ [NC]
  RewriteRule ^(.*)$ https://lazza.com.mx/$1 [R=301,L]
</IfModule>

# ---------------------------------------------------------------------------
# Compresión
# ---------------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ---------------------------------------------------------------------------
# Caché
#
# El sitio son 19 MB de fotografía y un video de hero: cachearlos fuerte es
# la diferencia entre una segunda visita instantánea y una lenta. El HTML se
# revalida siempre, para que un deploy se vea de inmediato.
#
# ⚠️ AL TOCAR lazza.css O lazza.js, SUBIR EL ?v= DE LAS 34 PÁGINAS.
# El 14-sep-2026 esto mordió: el CSS nuevo estaba en el servidor, pero los
# navegadores seguían con el de un mes antes y el botón de WhatsApp se veía
# roto, con el glifo en su propia línea. El HTML sí se revalida, así que basta
# con que el enlace cambie para que el navegador pida el archivo nuevo.
# Hay un script para hacerlo de una pasada: scripts/versionar-assets.py
# ---------------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg              "access plus 1 year"
  ExpiresByType image/png               "access plus 1 year"
  ExpiresByType image/webp              "access plus 1 year"
  ExpiresByType image/svg+xml           "access plus 1 year"
  ExpiresByType video/mp4               "access plus 1 year"
  ExpiresByType text/css                "access plus 1 month"
  ExpiresByType application/javascript  "access plus 1 month"
  ExpiresByType font/woff2              "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(html)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  # Encabezados de seguridad básicos
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# ---------------------------------------------------------------------------
# No servir archivos de trabajo si alguna vez llegaran al servidor
# ---------------------------------------------------------------------------
<FilesMatch "^(\.|README|.*\.md$)">
  Require all denied
</FilesMatch>
